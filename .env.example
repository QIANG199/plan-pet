# Z.ai Coding Plan API key (Authorization header, no Bearer)
ZAI_API_KEY=

# OpenCode Go 套餐 key（Authorization: Bearer）。cc-switch 里 “OpenCode Go”
# 提供商的 ANTHROPIC_AUTH_TOKEN 就是这把；留空则面板第三页显示 fail，其余照常
OPENCODE_GO_KEY=

# Shared with the ESP32 panel (header X-Panel-Token)
PANEL_TOKEN=

# Bind address. 0.0.0.0 so the panel can reach this PC on the LAN.
HOST=0.0.0.0
PORT=3737
